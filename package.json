{
  "name": "better-github",
  "version": "1.17.1",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pack": "node build.mjs && rm -f better-github.zip && cd dist && zip -r ../better-github.zip . -x '*icon-preview*' '*.DS_Store' && echo 'Packed: better-github.zip'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
