{
  "name": "better-github",
  "version": "1.20.0",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pack": "node build.mjs && rm -f better-github.zip && cd dist && zip -r ../better-github.zip . -x '*icon-preview*' '*.DS_Store' && echo 'Packed: better-github.zip'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
