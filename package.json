{
  "name": "better-github",
  "version": "1.17.0",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pack": "node build.mjs && rm -f better-github.zip && cd dist && zip -r ../better-github.zip . -x '*icon-preview*' '*.DS_Store' && echo 'Packed: better-github.zip'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@vitest/coverage-v8": "4.1.7",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
