{
  "manifest_version": 3,
  "name": "Better GitHub",
  "version": "1.1.0",
  "description": "Enhance GitHub with PR branch names, review status, label position, quick approve, Releases tab, and commit age color",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": ["https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
